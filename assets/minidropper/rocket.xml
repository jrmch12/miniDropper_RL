<!--
  miniDropper placeholder model (primitives only, until the CAD export exists).

  Body frame: origin = centre of mass, +z = rocket axis (nose up).
  Tube: diameter 6 cm, height 20 cm. Two coaxial counter-rotating EDFs inside,
  2-DoF gimballed nozzle below them (pivot ~9 cm below the CoM).

  Thrust, EDF reaction torque, servo dynamics, drag and tether forces are NOT
  MuJoCo actuators: they are computed in minidropper/task/dynamics.py from the
  per-config RocketParams and applied through data.xfrc_applied. Mass and
  inertia below are nominal and get overwritten per config (body_mass /
  body_inertia) by the config wrapper.
-->
<mujoco model="minidropper">
  <compiler autolimits="true" angle="radian"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler">
    <flag contact="disable"/>
  </option>

  <default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" mass="0"/>
    </default>
    <site group="5"/>
  </default>

  <asset>
    <material name="tube" rgba="0.85 0.85 0.88 1"/>
    <material name="nose" rgba="0.85 0.2 0.15 1"/>
    <material name="fin" rgba="0.15 0.15 0.18 1"/>
    <material name="edf" rgba="0.3 0.3 0.35 1"/>
  </asset>

  <worldbody>
    <body name="rocket" pos="0 0 3.0">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.40" diaginertia="1.42e-3 1.42e-3 1.8e-4"/>

      <!-- tube spans z = -0.08 .. +0.12 -->
      <geom name="tube" class="visual" type="cylinder" size="0.03 0.10" pos="0 0 0.02" material="tube"/>
      <geom name="nose" class="visual" type="ellipsoid" size="0.03 0.03 0.045" pos="0 0 0.12" material="nose"/>
      <!-- EDF rings (visual only) -->
      <geom name="edf_top" class="visual" type="cylinder" size="0.031 0.008" pos="0 0 -0.02" material="edf"/>
      <geom name="edf_bottom" class="visual" type="cylinder" size="0.031 0.008" pos="0 0 -0.055" material="edf"/>
      <!-- legs / fins -->
      <geom class="visual" type="box" size="0.002 0.012 0.03" pos=" 0.042 0 -0.06" material="fin"/>
      <geom class="visual" type="box" size="0.002 0.012 0.03" pos="-0.042 0 -0.06" material="fin"/>
      <geom class="visual" type="box" size="0.012 0.002 0.03" pos="0  0.042 -0.06" material="fin"/>
      <geom class="visual" type="box" size="0.012 0.002 0.03" pos="0 -0.042 -0.06" material="fin"/>

      <site name="imu" pos="0 0 0"/>
      <site name="gimbal_pivot" pos="0 0 -0.09"/>
    </body>
  </worldbody>

  <sensor>
    <framequat name="quat" objtype="site" objname="imu"/>
    <gyro name="gyro" site="imu"/>
    <accelerometer name="accel" site="imu"/>
    <framelinvel name="linvel" objtype="site" objname="imu"/>
  </sensor>
</mujoco>
